# คัดลอกเป็น .env.local (หรือใส่ใน Netlify → Environment variables)
# OAuth Client ID ชนิด Web application จาก Google Cloud Console (ดู SETUP.md)
VITE_GOOGLE_CLIENT_ID=
# URL ของ Apps Script Web App ที่ลงท้ายด้วย /exec
VITE_API_URL=
# (ไม่บังคับ) ลิงก์ Google Sheet สำหรับปุ่ม "เปิด Google Sheet" ในแอป
VITE_SHEET_URL=
