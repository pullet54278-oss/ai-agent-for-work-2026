rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(fid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }

    // users/{uid}: บอกว่าผู้ใช้อยู่ครอบครัวไหน — เจ้าของเท่านั้น
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /families/{fid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // สร้างครอบครัวใหม่ โดยมีตัวเองเป็นสมาชิกคนเดียว
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 6;

      // สมาชิกแก้ข้อมูลครอบครัวได้ (ยกเว้นเปลี่ยนรายชื่อสมาชิกตามใจ)
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        || joining();

      // เข้าร่วม: เพิ่มได้เฉพาะตัวเอง และต้องรู้รหัสเชิญที่ถูกต้อง
      function joining() {
        return signedIn()
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.joinCode == resource.data.inviteCode
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'joinCode'])
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]);
      }

      allow delete: if false;

      // ข้อมูลทุกอย่างของครอบครัว (people, appointments, expenses …)
      // ต้องมี {sub} นำหน้า: {document=**} เพียงอย่างเดียวจะจับตัวเอกสาร families/{fid} ด้วย
      match /{sub}/{document=**} {
        allow read, write: if isMember(fid);
      }
    }
  }
}
