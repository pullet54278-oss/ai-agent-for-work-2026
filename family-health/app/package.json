{
  "name": "family-health",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "build:e2e": "VITE_API_URL=mock vite build --outDir dist-e2e",
    "test:e2e": "npm run build:e2e && (vite preview --port 4173 --strictPort --outDir dist-e2e >/dev/null 2>&1 &) && sleep 3 && node tests/e2e.mjs; pkill -f \"vite preview --port 4173\" || true",
    "test:api": "node ../apps-script/test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
