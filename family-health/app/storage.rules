rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ไฟล์แนบ (ใบเสร็จ ใบรับรองแพทย์ รูปซองยา) เก็บใต้ families/{fid}/...
    match /families/{fid}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/families/$(fid)).data.members
        && (request.resource == null || request.resource.size < 10 * 1024 * 1024);
    }
  }
}
